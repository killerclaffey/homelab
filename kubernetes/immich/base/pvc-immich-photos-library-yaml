apiVersion: v1
kind: PersistentVolumeClaim
metadata:
  annotations:
    pv.kubernetes.io/bind-completed: 'yes'
  finalizers:
  - kubernetes.io/pvc-protection
  name: immich-photos-library
  namespace: immich
spec:
  accessModes:
  - ReadWriteMany
  resources:
    requests:
      storage: 1598Gi
  storageClassName: truenas-nfs-hdd
  volumeMode: Filesystem
  volumeName: immich-photos-library
