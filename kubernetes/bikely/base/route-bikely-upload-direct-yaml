apiVersion: route.openshift.io/v1
kind: Route
metadata:
  labels:
    app: upload-service
    deployment: okd
    environment: production
  name: bikely-upload-direct
  namespace: bikely
spec:
  host: upload.bikely.pro
  port:
    targetPort: 4002
  tls:
    insecureEdgeTerminationPolicy: Redirect
    termination: edge
  to:
    kind: Service
    name: bikely-upload-service
    weight: 100
  wildcardPolicy: None
