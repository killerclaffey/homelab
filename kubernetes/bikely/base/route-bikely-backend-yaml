apiVersion: route.openshift.io/v1
kind: Route
metadata:
  labels:
    app: backend
    deployment: okd
    environment: production
  name: bikely-backend
  namespace: bikely
spec:
  host: bikely.pro
  path: /api
  port:
    targetPort: 4000
  tls:
    insecureEdgeTerminationPolicy: Redirect
    termination: edge
  to:
    kind: Service
    name: bikely-backend-service
    weight: 100
  wildcardPolicy: None
