apiVersion: route.openshift.io/v1
kind: Route
metadata:
  annotations:
    haproxy.router.openshift.io/max-connections: '100'
    haproxy.router.openshift.io/timeout: 5m
    router.openshift.io/haproxy.health.check.interval: 5s
  labels:
    app: upload-service
    deployment: okd
    environment: production
  name: bikely-upload
  namespace: bikely
spec:
  host: bikely.pro
  path: /upload
  port:
    targetPort: 4002
  tls:
    insecureEdgeTerminationPolicy: Redirect
    termination: edge
  to:
    kind: Service
    name: bikely-upload-service
    weight: 100
  wildcardPolicy: None
