apiVersion: route.openshift.io/v1
kind: Route
metadata:
  labels:
    app: frontend
    deployment: okd
    environment: production
  name: bikely-frontend
  namespace: bikely
spec:
  host: bikely.pro
  port:
    targetPort: 3000
  tls:
    insecureEdgeTerminationPolicy: Redirect
    termination: edge
  to:
    kind: Service
    name: bikely-frontend-service
    weight: 100
  wildcardPolicy: None
