apiVersion: apps/v1
kind: Deployment
metadata:
  labels:
    app: bikely-upload-service
    app.kubernetes.io/managed-by: kustomize
    app.kubernetes.io/name: bikely
    deployment: okd
    environment: production
  name: bikely-upload-service
  namespace: bikely
spec:
  progressDeadlineSeconds: 600
  replicas: 3
  revisionHistoryLimit: 10
  selector:
    matchLabels:
      app: bikely-upload-service
      app.kubernetes.io/managed-by: kustomize
      app.kubernetes.io/name: bikely
      deployment: okd
      environment: production
  strategy:
    rollingUpdate:
      maxSurge: 25%
      maxUnavailable: 25%
    type: RollingUpdate
  template:
    metadata:
      annotations:
        kubectl.kubernetes.io/restartedAt: '2026-01-05T16:01:31-05:00'
      labels:
        app: bikely-upload-service
        app.kubernetes.io/managed-by: kustomize
        app.kubernetes.io/name: bikely
        deployment: okd
        environment: production
    spec:
      containers:
      - env:
        - name: NODE_ENV
          valueFrom:
            configMapKeyRef:
              key: NODE_ENV
              name: bikely-config
        - name: PORT
          value: '4002'
        - name: DATABASE_URL
          valueFrom:
            secretKeyRef:
              key: DATABASE_URL
              name: bikely-secrets
        - name: JWT_SECRET
          valueFrom:
            secretKeyRef:
              key: JWT_SECRET
              name: bikely-secrets
        image: image-registry.openshift-image-registry.svc:5000/bikely/upload-service:latest
        imagePullPolicy: IfNotPresent
        livenessProbe:
          failureThreshold: 3
          httpGet:
            path: /health
            port: 4002
            scheme: HTTP
          initialDelaySeconds: 30
          periodSeconds: 10
          successThreshold: 1
          timeoutSeconds: 1
        name: upload-service
        ports:
        - containerPort: 4002
          protocol: TCP
        readinessProbe:
          failureThreshold: 3
          httpGet:
            path: /health
            port: 4002
            scheme: HTTP
          initialDelaySeconds: 5
          periodSeconds: 5
          successThreshold: 1
          timeoutSeconds: 1
        resources:
          limits:
            cpu: 500m
            memory: 256Mi
          requests:
            cpu: 250m
            memory: 128Mi
        terminationMessagePath: /dev/termination-log
        terminationMessagePolicy: File
      dnsPolicy: ClusterFirst
      imagePullSecrets:
      - name: default-dockercfg-k79sz
      restartPolicy: Always
      schedulerName: default-scheduler
      securityContext: {}
      terminationGracePeriodSeconds: 30
