apiVersion: route.openshift.io/v1
kind: Route
metadata:
  name: bikely-tileserver
  namespace: bikely
spec:
  host: tiles.bikely.pro
  port:
    targetPort: 8080
  tls:
    insecureEdgeTerminationPolicy: Redirect
    termination: edge
  to:
    kind: Service
    name: bikely-tileserver-service
    weight: 100
  wildcardPolicy: None
