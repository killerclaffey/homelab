apiVersion: v1
kind: Service
metadata:
  annotations:
    cloud.google.com/backend-config: '{"default": "bikely-backend-config"}'
  labels:
    app.kubernetes.io/managed-by: kustomize
    app.kubernetes.io/name: bikely
    deployment: okd
    environment: production
  name: bikely-backend-service
  namespace: bikely
spec:
  externalTrafficPolicy: Cluster
  internalTrafficPolicy: Cluster
  ipFamilies:
  - IPv4
  ipFamilyPolicy: SingleStack
  ports:
  - nodePort: 31027
    port: 4000
    protocol: TCP
    targetPort: 4000
  selector:
    app: bikely-backend
    app.kubernetes.io/managed-by: kustomize
    app.kubernetes.io/name: bikely
    deployment: okd
    environment: production
  sessionAffinity: None
  type: NodePort
