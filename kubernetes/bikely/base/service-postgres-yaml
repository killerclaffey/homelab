apiVersion: v1
kind: Service
metadata:
  name: postgres
  namespace: bikely
spec:
  internalTrafficPolicy: Cluster
  ipFamilies:
  - IPv4
  ipFamilyPolicy: SingleStack
  ports:
  - port: 5432
    protocol: TCP
    targetPort: 5432
  selector:
    cnpg.io/cluster: bikely-db
    role: primary
  sessionAffinity: None
  type: ClusterIP
