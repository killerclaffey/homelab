apiVersion: v1
kind: Service
metadata:
  name: postgres
  namespace: bikely-dev
spec:
  clusterIP: 172.30.125.14
  clusterIPs:
  - 172.30.125.14
  internalTrafficPolicy: Cluster
  ipFamilies:
  - IPv4
  ipFamilyPolicy: SingleStack
  ports:
  - port: 5432
    protocol: TCP
    targetPort: 5432
  selector:
    app: postgres
  sessionAffinity: None
  type: ClusterIP
