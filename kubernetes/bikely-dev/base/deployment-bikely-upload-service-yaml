apiVersion: apps/v1
kind: Deployment
metadata:
  name: bikely-upload-service
  namespace: bikely-dev
spec:
  progressDeadlineSeconds: 600
  replicas: 1
  revisionHistoryLimit: 10
  selector:
    matchLabels:
      app: bikely-upload-service
  strategy:
    rollingUpdate:
      maxSurge: 25%
      maxUnavailable: 25%
    type: RollingUpdate
  template:
    metadata:
      annotations:
        kubectl.kubernetes.io/restartedAt: '2026-01-29T22:28:10-05:00'
      labels:
        app: bikely-upload-service
    spec:
      containers:
      - env:
        - name: DATABASE_URL
          value: postgresql://fitness_user:fitness_pass@postgres.bikely-dev.svc.cluster.local:5432/fitness_app
        - name: PORT
          value: '4002'
        envFrom:
        - configMapRef:
            name: bikely-config
        - secretRef:
            name: bikely-secrets
        image: image-registry.openshift-image-registry.svc:5000/bikely-dev/bikely-upload-service:latest
        imagePullPolicy: Always
        name: upload-service
        ports:
        - containerPort: 4002
          protocol: TCP
        resources:
          limits:
            cpu: '1'
            memory: 1Gi
          requests:
            cpu: 500m
            memory: 512Mi
        terminationMessagePath: /dev/termination-log
        terminationMessagePolicy: File
      dnsPolicy: ClusterFirst
      imagePullSecrets:
      - name: default-dockercfg-t9mlg
      restartPolicy: Always
      schedulerName: default-scheduler
      securityContext: {}
      terminationGracePeriodSeconds: 30
