apiVersion: route.openshift.io/v1
kind: Route
metadata:
  name: bikely-dev-tileserver
  namespace: bikely-dev
spec:
  host: tiles.devbikely.claffey.cloud
  port:
    targetPort: 8080
  tls:
    insecureEdgeTerminationPolicy: Redirect
    termination: edge
  to:
    kind: Service
    name: bikely-tileserver-service
    weight: 100
  wildcardPolicy: None
