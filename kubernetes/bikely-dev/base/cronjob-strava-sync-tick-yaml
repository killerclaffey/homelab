apiVersion: batch/v1
kind: CronJob
metadata:
  name: strava-sync-tick
  namespace: bikely-dev
  labels:
    app: strava-sync-tick
spec:
  schedule: "0 */6 * * *"
  # Suspended in dev so dev DB clones of prod Strava tokens cannot rotate
  # single-use refresh tokens out from under production. Trigger manually via:
  #   oc create job --from=cronjob/strava-sync-tick manual-tick -n bikely-dev
  suspend: true
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 2
  failedJobsHistoryLimit: 3
  startingDeadlineSeconds: 300
  jobTemplate:
    spec:
      activeDeadlineSeconds: 120
      backoffLimit: 1
      template:
        spec:
          restartPolicy: Never
          securityContext:
            runAsNonRoot: true
            seccompProfile:
              type: RuntimeDefault
          containers:
            - name: tick
              image: registry.access.redhat.com/ubi9/ubi-minimal:latest@sha256:08d4c70f1baf6537a0728656cf7942d561e74a35916509d205b6519861266352
              imagePullPolicy: IfNotPresent
              securityContext:
                allowPrivilegeEscalation: false
                runAsNonRoot: true
                capabilities:
                  drop:
                    - ALL
              command:
                - /bin/sh
                - -c
                - |
                  set -eu
                  curl -fsS --max-time 30 -X POST \
                    -H "x-ly-service-token: ${LY_SERVICE_TOKEN}" \
                    http://bikely-backend-service:4000/api/strava/sync/tick
                  echo ""
              env:
                - name: LY_SERVICE_TOKEN
                  valueFrom:
                    secretKeyRef:
                      name: bikely-secrets
                      key: LY_SERVICE_TOKEN
              resources:
                requests:
                  cpu: 25m
                  memory: 32Mi
                limits:
                  cpu: 100m
                  memory: 64Mi
