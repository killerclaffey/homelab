apiVersion: v1
kind: Service
metadata:
  name: bikely-backend-service
  namespace: bikely-dev
spec:
  internalTrafficPolicy: Cluster
  ipFamilies:
  - IPv4
  ipFamilyPolicy: SingleStack
  ports:
  - port: 4000
    protocol: TCP
    targetPort: 4000
  selector:
    app: bikely-backend
  sessionAffinity: None
  type: ClusterIP
