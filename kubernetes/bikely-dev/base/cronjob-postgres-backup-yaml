apiVersion: batch/v1
kind: CronJob
metadata:
  name: postgres-backup
  namespace: bikely-dev
  labels:
    app: postgres-backup
spec:
  schedule: "0 2 * * *"
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 1
  failedJobsHistoryLimit: 2
  startingDeadlineSeconds: 300
  jobTemplate:
    spec:
      activeDeadlineSeconds: 1800
      backoffLimit: 2
      template:
        spec:
          restartPolicy: Never
          securityContext:
            runAsNonRoot: true
            seccompProfile:
              type: RuntimeDefault
          containers:
            - name: postgres-backup
              image: docker.io/library/postgres:15-alpine
              imagePullPolicy: IfNotPresent
              command:
                - /bin/sh
                - -c
                - |
                  set -e
                  BACKUP_DIR="/backups"
                  TIMESTAMP=$(date +%Y%m%d_%H%M%S)
                  BACKUP_FILE="${BACKUP_DIR}/backup_${TIMESTAMP}.sql.gz"
                  MAX_BACKUPS=4

                  echo "Starting backup at $(date)"
                  PGPASSWORD="${POSTGRES_PASSWORD}" pg_dump \
                    -h postgres \
                    -U "${POSTGRES_USER}" \
                    -d "${POSTGRES_DB}" \
                    --no-owner \
                    --no-acl \
                    | gzip > "${BACKUP_FILE}"

                  echo "Backup created: ${BACKUP_FILE}"
                  ls -lh "${BACKUP_FILE}"

                  echo "Rotating backups, keeping ${MAX_BACKUPS} most recent..."
                  cd "${BACKUP_DIR}"
                  ls -t backup_*.sql.gz 2>/dev/null | tail -n +$((MAX_BACKUPS + 1)) | xargs -r rm -v
                  echo "Backup completed at $(date)"
              env:
                - name: POSTGRES_USER
                  value: fitness_user
                - name: POSTGRES_DB
                  value: fitness_app
                - name: POSTGRES_PASSWORD
                  valueFrom:
                    secretKeyRef:
                      name: bikely-secrets
                      key: POSTGRES_PASSWORD
              resources:
                requests:
                  cpu: 100m
                  memory: 256Mi
                limits:
                  cpu: 500m
                  memory: 512Mi
              volumeMounts:
                - name: backup-storage
                  mountPath: /backups
          volumes:
            - name: backup-storage
              persistentVolumeClaim:
                claimName: postgres-backup-pvc
