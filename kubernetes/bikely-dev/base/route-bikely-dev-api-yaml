apiVersion: route.openshift.io/v1
kind: Route
metadata:
  name: bikely-dev-api
  namespace: bikely-dev
spec:
  host: devbikely.claffey.cloud
  path: /api
  port:
    targetPort: 4000
  tls:
    insecureEdgeTerminationPolicy: Redirect
    termination: edge
  to:
    kind: Service
    name: bikely-backend-service
    weight: 100
  wildcardPolicy: None
