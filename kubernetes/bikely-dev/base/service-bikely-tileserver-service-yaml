apiVersion: v1
kind: Service
metadata:
  labels:
    app: bikely-tileserver
  name: bikely-tileserver-service
  namespace: bikely-dev
spec:
  internalTrafficPolicy: Cluster
  ipFamilies:
    - IPv4
  ipFamilyPolicy: SingleStack
  ports:
    - name: http
      port: 8080
      protocol: TCP
      targetPort: 8080
  selector:
    app: bikely-tileserver
  sessionAffinity: None
  type: ClusterIP
