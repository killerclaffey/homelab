apiVersion: v1
kind: Service
metadata:
  name: bikely-frontend-service
  namespace: bikely-dev
spec:
  clusterIP: 172.30.225.79
  clusterIPs:
  - 172.30.225.79
  internalTrafficPolicy: Cluster
  ipFamilies:
  - IPv4
  ipFamilyPolicy: SingleStack
  ports:
  - port: 3000
    protocol: TCP
    targetPort: 3000
  selector:
    app: bikely-frontend
  sessionAffinity: None
  type: ClusterIP
