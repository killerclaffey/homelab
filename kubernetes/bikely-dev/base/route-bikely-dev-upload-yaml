apiVersion: route.openshift.io/v1
kind: Route
metadata:
  name: bikely-dev-upload
  namespace: bikely-dev
spec:
  host: devbikely.claffey.cloud
  path: /upload
  port:
    targetPort: 4002
  tls:
    insecureEdgeTerminationPolicy: Redirect
    termination: edge
  to:
    kind: Service
    name: bikely-upload-service
    weight: 100
  wildcardPolicy: None
