apiVersion: v1
kind: Service
metadata:
  name: gitlab-webhook-service
  namespace: gitlab-system
spec:
  clusterIP: 172.30.22.156
  clusterIPs:
  - 172.30.22.156
  internalTrafficPolicy: Cluster
  ipFamilies:
  - IPv4
  ipFamilyPolicy: SingleStack
  ports:
  - port: 443
    protocol: TCP
    targetPort: 9443
  selector:
    control-plane: controller-manager
  sessionAffinity: None
  type: ClusterIP
