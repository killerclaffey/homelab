apiVersion: v1
kind: Service
metadata:
  labels:
    control-plane: controller-manager
  name: gitlab-controller-manager-metrics-service
  namespace: gitlab-system
spec:
  internalTrafficPolicy: Cluster
  ipFamilies:
  - IPv4
  ipFamilyPolicy: SingleStack
  ports:
  - name: https
    port: 8443
    protocol: TCP
    targetPort: metrics
  selector:
    control-plane: controller-manager
  sessionAffinity: None
  type: ClusterIP
